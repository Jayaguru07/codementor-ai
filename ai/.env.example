# ============================================================
# CodeMentor AI - Environment Configuration Example
# ============================================================
# Copy this file to .env inside the ai/ directory:
#   cp .env.example .env
#
# Replace the placeholders with your cloud LLM credentials.
# NEVER commit your actual .env file or hardcode API keys!
# ============================================================

# Cloud LLM API Key (OpenAI, Groq, OpenRouter, Together AI, etc.)
LLM_API_KEY=your_cloud_llm_api_key_here

# Model name to use
# Examples:
#   OpenAI:      gpt-4o-mini, gpt-4o
#   Groq:        llama-3.1-8b-instant, mixtral-8x7b-32768
#   OpenRouter:  meta-llama/llama-3-8b-instruct
LLM_MODEL=gpt-4o-mini

# Base URL for the OpenAI-compatible chat completions endpoint
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together AI: https://api.together.xyz/v1
LLM_BASE_URL=https://api.openai.com/v1
